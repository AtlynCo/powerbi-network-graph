table Contributions

	measure 'Contributions Total Weight' = SUM('Contributions'[Weight])
		formatString: #,0.##
		displayFolder: Investigation

	measure 'Contributions Input Rows' = COUNTROWS('Contributions')
		formatString: #,0
		displayFolder: Investigation

	measure 'Contributions Events' = SUM('Contributions'[EventCount])
		formatString: #,0
		displayFolder: Investigation

	measure 'Contributions Average Duration ms' = AVERAGE('Contributions'[DurationMs])
		formatString: #,0.0
		displayFolder: Investigation

	measure 'Contributions Blank Weights' = COUNTROWS(FILTER('Contributions', ISBLANK('Contributions'[Weight])))
		formatString: #,0
		displayFolder: Investigation

	measure 'Contributions Nonpositive Weights' = COUNTROWS(FILTER('Contributions', NOT(ISBLANK('Contributions'[Weight])) && 'Contributions'[Weight] <= 0))
		formatString: #,0
		displayFolder: Investigation

	measure 'Contributions Visible Nodes' = COUNTROWS(DISTINCT(UNION(SELECTCOLUMNS('Contributions', "ID", 'Contributions'[SourceID]), SELECTCOLUMNS('Contributions', "ID", 'Contributions'[TargetID]))))
		formatString: #,0
		displayFolder: Investigation

	column SourceID
		dataType: string
		sourceColumn: SourceID
		summarizeBy: none

	column TargetID
		dataType: string
		sourceColumn: TargetID
		summarizeBy: none

	column RelationshipType
		dataType: string
		sourceColumn: RelationshipType
		summarizeBy: none

	column EdgeID
		dataType: string
		sourceColumn: EdgeID
		summarizeBy: none

	column ItemID
		dataType: string
		sourceColumn: ItemID
		summarizeBy: none

	column Weight
		dataType: double
		sourceColumn: Weight
		summarizeBy: sum
		formatString: #,0.##

	column DurationMs
		dataType: double
		sourceColumn: DurationMs
		summarizeBy: sum

	column EventCount
		dataType: int64
		sourceColumn: EventCount
		summarizeBy: sum

	partition Contributions = m
		mode: import
		source =
			#table(type table [SourceID = text, TargetID = nullable text, RelationshipType = text, EdgeID = text, ItemID = text, Weight = nullable number, DurationMs = number, EventCount = Int64.Type], {
