	partition ServicesTypes = m
		mode: import
		source =
			#table(type table [RelationshipType = text], {
				{"calls"},
				{"confirms"},
				{"copies"},
				{"emits"},
				{"monitors"},
				{"notifies"},
				{"reconciles"},
				{"reserves"},
				{"responds"},
				{"retries"},
				{"verifies"},
				{"writes"}
			})

	annotation PBI_ResultType = Table
