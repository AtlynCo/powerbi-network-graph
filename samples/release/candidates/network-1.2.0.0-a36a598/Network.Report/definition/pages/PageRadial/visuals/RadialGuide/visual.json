                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Automatic center is Orders: largest component, most distinct non-self neighbors, then stable ID. This is a layout convenience, not centrality or business importance.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use the Radial center selector or Use as radial center in the entity list. This does not change visible local focus, weights, report filters or selection.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each ring is minimum UNDIRECTED hop distance over all loaded relationships. Arrows still preserve original direction. Parallel edges and loops do not add hops.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Archive/Backup is separately packed with its own real center; there is no distance between disconnected components.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A filtered-out requested center is retained, with a visible automatic fallback, and returns when loaded again.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Search, focus and highlights do not move nodes. Save local view stores mode/center; native bookmark and Desktop/Service replay still require owner verification.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
